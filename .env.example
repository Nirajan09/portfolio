# Contact form delivery:
# Option 1: Web3Forms (https://web3forms.com)
WEB3FORMS_ACCESS_KEY=
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Option 2: Resend (https://resend.com)
RESEND_API_KEY=
# Where messages are delivered (your inbox).
CONTACT_TO_EMAIL=
# Verified sender, e.g. "Portfolio <contact@yourdomain.com>".
# For testing, "onboarding@resend.dev" only delivers to your own Resend account email.
CONTACT_FROM_EMAIL=

# Analytics (all optional and public by design). Loaded in production only.
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Set to "true" if you deploy on Vercel and enabled Web Analytics there.
NEXT_PUBLIC_VERCEL_ANALYTICS=