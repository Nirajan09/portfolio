# ==============================================================================
# Portfolio Environment Variables Template (.env.example)
# ==============================================================================
# Duplicate this file as .env.local (or .env) and set your values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Contact Form Delivery (Web3Forms - https://web3forms.com)
# ------------------------------------------------------------------------------
# Free access key sent directly to your email inbox from https://web3forms.com
# Keep this as a private server environment variable (never exposed in client bundles).
WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# ------------------------------------------------------------------------------
# 2. Analytics & Tracking (Optional - Active in production only)
# ------------------------------------------------------------------------------
# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Vercel Web Analytics: Set to "true" if deployed on Vercel with Analytics enabled
NEXT_PUBLIC_VERCEL_ANALYTICS=false

# Local Development Testing: Set to "true" to test GA/Vercel scripts on localhost:3000
NEXT_PUBLIC_ENABLE_ANALYTICS_IN_DEV=false

# ------------------------------------------------------------------------------
# 3. SEO & Search Engine Indexing
# ------------------------------------------------------------------------------
# Set to "true" to allow Googlebot and Bingbot to index the website in production
NEXT_PUBLIC_ALLOW_INDEXING=true

# ------------------------------------------------------------------------------
# 4. Testing & Script Tooling
# ------------------------------------------------------------------------------
# Target URL for automated security & contact tests (scripts/test-contact-security.mjs)
TEST_URL=http://localhost:3000